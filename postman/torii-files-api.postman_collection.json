                    "value": "1.1"
                  },
                  {
                    "key": "Content-Type",
                    "value": "multipart/form-data"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "description": "(Required) The file to upload (max 3MB).",
                      "key": "file",
                      "type": "file",
                      "value": null
                    }
                  ]
                },
                "url": {
                  "raw": "{{baseUrl}}/files/upload",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "files",
                    "upload"
                  ]
                },
                "description": "Upload small files up to 3MB as multipart form data. Supported file types: .csv, .xls, .xlsx, .pdf, .doc, .docx, .png, .jpg, .jpeg, .xml, .json, .zip."
